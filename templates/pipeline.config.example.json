{
  "name": "my-project",
  "workspace": ".",
  "stateDir": ".pipeline-state",
  "agent": {
    "provider": "claude",
    "fallback": [],
    "maxMinutes": 50,
    "model": "",
    "plan": { "provider": "", "model": "", "maxMinutes": 20 }
  },
  "tracker": {
    "type": "file",
    "file": "tickets.json"
  },
  "vcs": {
    "type": "none"
  },
  "knowledge": {
    "enabled": true,
    "indexFile": "docs/project-index.json",
    "graphFile": "docs/project-graph.json",
    "indexMarkdown": "docs/PROJECT-INDEX.md",
    "maxContextFiles": 15,
    "adapters": ["dotnet"]
  },
  "preflight": {
    "enabled": true,
    "requireDescription": true,
    "minDescriptionChars": 20
  },
  "plan": { "enabled": true, "perTick": 2 },
  "docs": {
    "featuresDir": "docs/features",
    "lessonsDir": "docs/memory/lessons",
    "memoryIndex": "docs/memory/INDEX.md",
    "featureIndex": "docs/FEATURES.md"
  },
  "gates": {
    "build": "",
    "unitTests": ""
  },
  "qa": {
    "command": "node qa/run-qa.mjs {ticket}",
    "exitCodes": { "pass": 0, "fail": 2, "blocked": 3 }
  },
  "deploy": {
    "command": "",
    "smokeCommand": "",
    "batchMin": 10
  },
  "limits": {
    "maxAttempts": 3,
    "pauseReadyWhenRedoAtLeast": 5,
    "quotaHoldMinutes": 60
  }
}
